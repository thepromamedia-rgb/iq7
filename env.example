# Use a long random secret for signed login sessions.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional path for the JSON database. On Render free, local files may reset on redeploy/restart.
# DATA_DIR=/var/data

# Set a strong private password to enable the admin panel
ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional manual-deposit payment details shown in the wallet page
PAYMENT_UPI_ID=your-upi-id@bank
PAYMENT_NAME=IQ63
