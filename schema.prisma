generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { SUPER_ADMIN OWNER MANAGER STAFF KITCHEN }
enum OrderStatus { PENDING ACCEPTED PREPARING READY COMPLETED CANCELLED }
enum PaymentStatus { UNPAID PAID REFUND_PENDING REFUNDED }
enum SubscriptionStatus { TRIAL ACTIVE PAST_DUE CANCELLED EXPIRED }
model User { id String @id @default(cuid()) email String @unique passwordHash String name String role Role @default(OWNER) cafeId String? cafe Cafe? @relation(fields:[cafeId],references:[id]) active Boolean @default(true) createdAt DateTime @default(now()) auditLogs AuditLog[] }
model Cafe { id String @id @default(cuid()) name String slug String @unique phone String? address String? logoUrl String? primaryColor String @default("#79543e") gstRate Float @default(5) currency String @default("INR") trialEndsAt DateTime? subscriptionStatus SubscriptionStatus @default(TRIAL) createdAt DateTime @default(now()) users User[] categories Category[] products Product[] tables CafeTable[] orders Order[] customers Customer[] loyaltyProgram LoyaltyProgram? coupons Coupon[] rewards Reward[] subscription Subscription? auditLogs AuditLog[] }
model Category { id String @id @default(cuid()) cafeId String cafe Cafe @relation(fields:[cafeId],references:[id],onDelete:Cascade) name String sortOrder Int @default(0) active Boolean @default(true) products Product[] @@index([cafeId]) }
model Product { id String @id @default(cuid()) cafeId String cafe Cafe @relation(fields:[cafeId],references:[id],onDelete:Cascade) categoryId String? category Category? @relation(fields:[categoryId],references:[id]) name String description String? price Int imageUrl String? isVeg Boolean @default(true) available Boolean @default(true) stock Int? lowStockAt Int @default(5) addons Json? createdAt DateTime @default(now()) orderItems OrderItem[] @@index([cafeId,available]) }
model CafeTable { id String @id @default(cuid()) cafeId String cafe Cafe @relation(fields:[cafeId],references:[id],onDelete:Cascade) name String qrToken String @unique active Boolean @default(true) createdAt DateTime @default(now()) orders Order[] @@index([cafeId]) }
model Customer { id String @id @default(cuid()) cafeId String cafe Cafe @relation(fields:[cafeId],references:[id],onDelete:Cascade) name String phone String? email String? marketingConsent Boolean @default(false) birthday DateTime? createdAt DateTime @default(now()) orders Order[] loyalty LoyaltyAccount? @@unique([cafeId,phone]) @@index([cafeId]) }
model Order { id String @id @default(cuid()) orderNo String cafeId String cafe Cafe @relation(fields:[cafeId],references:[id],onDelete:Cascade) tableId String? table CafeTable? @relation(fields:[tableId],references:[id]) customerId String? customer Customer? @relation(fields:[customerId],references:[id]) customerName String total Int subtotal Int tax Int discount Int @default(0) status OrderStatus @default(PENDING) paymentStatus PaymentStatus @default(UNPAID) notes String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt items OrderItem[] @@unique([cafeId,orderNo]) @@index([cafeId,status,createdAt]) }
model OrderItem { id String @id @default(cuid()) orderId String order Order @relation(fields:[orderId],references:[id],onDelete:Cascade) productId String? product Product? @relation(fields:[productId],references:[id]) name String quantity Int unitPrice Int addons Json? }
model LoyaltyProgram { id String @id @default(cuid()) cafeId String @unique cafe Cafe @relation(fields:[cafeId],references:[id],onDelete:Cascade) enabled Boolean @default(true) stampsRequired Int @default(5) rewardName String @default("Free coffee") minimumSpend Int @default(0) }
model LoyaltyAccount { id String @id @default(cuid()) customerId String @unique customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade) stamps Int @default(0) lifetimeStamps Int @default(0) updatedAt DateTime @updatedAt entries Stamp[] }
model Stamp { id String @id @default(cuid()) accountId String account LoyaltyAccount @relation(fields:[accountId],references:[id],onDelete:Cascade) orderId String @unique createdAt DateTime @default(now()) }
model Reward { id String @id @default(cuid()) cafeId String cafe Cafe @relation(fields:[cafeId],references:[id],onDelete:Cascade) name String description String? stampsCost Int active Boolean @default(true) expiresInDays Int? }
model Coupon { id String @id @default(cuid()) cafeId String cafe Cafe @relation(fields:[cafeId],references:[id],onDelete:Cascade) code String discountType String discountValue Int minOrder Int @default(0) maxUses Int? uses Int @default(0) startsAt DateTime? endsAt DateTime? active Boolean @default(true) @@unique([cafeId,code]) }
model Redemption { id String @id @default(cuid()) cafeId String customerId String rewardId String code String status String @default("ISSUED") expiresAt DateTime? redeemedAt DateTime? createdAt DateTime @default(now()) @@index([cafeId,code]) }
model SubscriptionPlan { id String @id @default(cuid()) name String @unique price Int features Json active Boolean @default(true) subscriptions Subscription[] }
model Subscription { id String @id @default(cuid()) cafeId String @unique cafe Cafe @relation(fields:[cafeId],references:[id]) planId String plan SubscriptionPlan @relation(fields:[planId],references:[id]) status SubscriptionStatus @default(TRIAL) startsAt DateTime @default(now()) endsAt DateTime? gatewaySubscriptionId String? }
model Payment { id String @id @default(cuid()) cafeId String amount Int currency String @default("INR") status String gateway String? gatewayPaymentId String? createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) cafeId String? cafe Cafe? @relation(fields:[cafeId],references:[id]) userId String? user User? @relation(fields:[userId],references:[id]) action String entity String? entityId String? metadata Json? ip String? createdAt DateTime @default(now()) @@index([cafeId,createdAt]) }
model SupportRequest { id String @id @default(cuid()) cafeId String? subject String message String status String @default("OPEN") createdAt DateTime @default(now()) }
